+def neuron_bounds(spec, total):
+    if spec is None:
+        return 0, total
+    parts = spec.split(":")
+    if len(parts) != 2:
+        raise ValueError("--neurons must be START:STOP, with an exclusive STOP")
+    start, stop = map(int, parts)
+    if not 0 <= start < stop <= total:
+        raise ValueError(f"neuron range must satisfy 0 <= START < STOP <= {total}")
+    return start, stop
